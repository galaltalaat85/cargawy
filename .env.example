# ─────────────────────────────────────────────────────────────
# CarGawy — environment configuration
# Copy to `.env` and fill in values. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# Public base URL (used for canonical URLs, sitemap, emails, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to true ONLY on the live production domain. Anything else serves "Disallow: /" in robots.txt.
ALLOW_INDEXING=false

# Database (PostgreSQL)
DATABASE_URL="postgresql://cargawy:cargawy_dev@localhost:5432/cargawy?schema=public"
# Used only by the automated test suite (will be reset by tests!)
TEST_DATABASE_URL="postgresql://cargawy:cargawy_dev@localhost:5432/cargawy_test?schema=public"

# Auth
# Random 32+ char string. Generate: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string
# Session lifetime in days
SESSION_TTL_DAYS=30
# Require email verification before customer accounts can log in (true/false)
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Storage — "local" (dev, writes to ./storage/uploads) or "s3" (any S3-compatible: AWS S3, Cloudflare R2, MinIO, Backblaze B2, DigitalOcean Spaces)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for the bucket/CDN, e.g. https://cdn.cargawy.com
S3_PUBLIC_URL=
# true for MinIO / some providers
S3_FORCE_PATH_STYLE=false
# Max upload size per image in MB
UPLOAD_MAX_MB=10

# Email — "console" (dev, logs emails) or "smtp"
EMAIL_DRIVER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM="CarGawy <no-reply@cargawy.com>"
# Comma separated list of addresses notified about new leads / sell requests
ADMIN_NOTIFICATION_EMAILS=

# Redis (optional; leave empty to use in-memory rate limiting for single instance)
REDIS_URL=

# Analytics (optional; leave empty to disable)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# Seed (development only — the seed refuses to create demo accounts in production)
SEED_ADMIN_EMAIL=admin@cargawy.local
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_DEMO_CARS=true
